# Terminal Matematico - servidor domestico, perfil PRODUCAO.
# Copie para /etc/terminal-matematico/server.env (dono root, grupo terminalmat, modo 0640).
# NAO coloque chaves de API aqui: elas sao cadastradas no painel e guardadas cifradas no banco.

MT_PROFILE=production
MT_DATA_DIR=/var/lib/terminal-matematico

# Listener exclusivo do cloudflared (Cloudflare Tunnel). Sempre loopback.
SERVER_LOCAL_HOST=127.0.0.1
SERVER_LOCAL_PORT=8787

# Listener HTTPS opcional na rede de casa (acesso direto do terminal pela LAN).
# Gere o certificado com deploy/linux/gen-lan-cert.sh.
LAN_ENABLED=0
LAN_HOST=0.0.0.0
LAN_PORT=8443
TLS_CERT_FILE=/etc/terminal-matematico/tls/server.crt
TLS_KEY_FILE=/etc/terminal-matematico/tls/server.key
# Painel administrativo pela LAN (desligado por padrao: use o hostname protegido pelo Access).
ADMIN_ON_LAN=0
ALLOW_INSECURE_HTTP=0

# Cloudflare (preencha depois de criar o tunel; veja deploy/cloudflared/README.md)
PUBLIC_HOSTNAME=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_ACCESS_ENABLED=1
CLOUDFLARE_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD_DEVICE=
CLOUDFLARE_ACCESS_AUD_ADMIN=

# Autenticacao
DEVICE_AUTH_MODE=hmac+access
ADMIN_AUTH_MODE=password+access
ADMIN_REQUIRE_TOTP=1
ADMIN_SESSION_MINUTES=30

# Chave mestra (opcional). Sem ela o servidor cria MT_DATA_DIR/master.key (0600).
# MT_MASTER_KEY=

# Limites
MAX_CONCURRENT_TASKS=2
MAX_QUEUE_PER_DEVICE=2
TASK_TIMEOUT_MS=180000
REQUEST_WAIT_MS=25000
RESULT_TTL_MS=900000
MAX_TEXT_BYTES=8192
MAX_IMAGE_BYTES=3145728
MAX_IMAGE_DIM=4096
RATE_PER_MINUTE=10
DAILY_QUOTA=300
CLOCK_SKEW_SEC=300
STEPS_PER_PAGE=20

# Aplicativos CLI oficiais (opcionais), executados pelo usuario de servico, nunca como root.
CODEX_BIN=codex
CLAUDE_BIN=claude
CLI_HOME=/var/lib/terminal-matematico/cli-home
