# Terminal Matematico - perfil DESENVOLVIMENTO (maquina do desenvolvedor).
# Uso: set -a; . deploy/env/development.env; set +a; cd backend && npm start
MT_PROFILE=development
MT_DATA_DIR=./data
SERVER_LOCAL_HOST=127.0.0.1
SERVER_LOCAL_PORT=8787
LAN_ENABLED=0
ADMIN_ON_LAN=0
ALLOW_INSECURE_HTTP=0
CLOUDFLARE_ACCESS_ENABLED=0
DEVICE_AUTH_MODE=hmac
ADMIN_AUTH_MODE=password
ADMIN_REQUIRE_TOTP=0
# O simulador web roda em outra porta: libere CORS apenas para ele.
CORS_ORIGIN=http://127.0.0.1:8080
CODEX_BIN=codex
CLAUDE_BIN=claude
