[Unit]
Description=Terminal Matematico - servidor domestico (API dos dispositivos e painel)
Documentation=file:///opt/terminal-matematico/docs/SERVER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terminalmat
Group=terminalmat
EnvironmentFile=/etc/terminal-matematico/server.env
WorkingDirectory=/opt/terminal-matematico/backend
ExecStart=/usr/bin/env node --disable-warning=ExperimentalWarning src/server.ts
Restart=on-failure
RestartSec=5
UMask=0077

# Recursos (ajuste ao servidor)
MemoryMax=768M
TasksMax=128
LimitNOFILE=4096

# Endurecimento: o servico so escreve no diretorio de dados.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/terminal-matematico
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# Node precisa de JIT: MemoryDenyWriteExecute fica desligado de proposito.

[Install]
WantedBy=multi-user.target
