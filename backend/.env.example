# Copie para .env (nao versionado) ou defina no ambiente do servico.
ANTHROPIC_API_KEY=            # chave da API (somente no servidor, nunca no firmware)
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium              # low | medium | high | xhigh | max
AI_PROVIDER=anthropic         # anthropic | mock
PORT=8443
HOST=0.0.0.0
TLS_CERT_FILE=/etc/terminal/tls/fullchain.pem
TLS_KEY_FILE=/etc/terminal/tls/privkey.pem
# ALLOW_INSECURE_HTTP=1       # apenas desenvolvimento local / atras de proxy TLS
DEVICES_FILE=data/devices.json
AI_TIMEOUT_MS=90000
MAX_TEXT_BYTES=8192
MAX_IMAGE_BYTES=3145728
MAX_IMAGE_DIM=4096
RATE_PER_MINUTE=10
DAILY_QUOTA=300
CLOCK_SKEW_SEC=300
# CORS_ORIGIN=http://localhost:8080   # somente para o simulador web
